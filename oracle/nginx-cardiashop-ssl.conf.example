# Cardiashop migration template. NOT active until cert has all 4 SANs.
# Certificate must cover cardiashop.fr, www.cardiashop.fr,
# cardoriashop.fr and www.cardoriashop.fr.
# Before installation verify: nginx -t, cert SANs, backup old config.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    location / {
        proxy_pass http://127.0.0.1:10000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
server {
    listen 80;
    listen [::]:80;
    server_name cardiashop.fr www.cardiashop.fr cardoriashop.fr www.cardoriashop.fr;
    location /.well-known/acme-challenge/ {
        root /var/www/cardoria-acme;
        default_type text/plain;
    }
    location / { return 301 https://www.cardiashop.fr$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name cardiashop.fr cardoriashop.fr www.cardoriashop.fr;
    ssl_certificate /etc/letsencrypt/live/cardoriashop.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cardoriashop.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://www.cardiashop.fr$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.cardiashop.fr;
    ssl_certificate /etc/letsencrypt/live/cardoriashop.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cardoriashop.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25m;
    # Keep Node's Permissions-Policy for camera and microphone.
    location / {
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
