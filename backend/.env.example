# Cardoria V6 — Variables d'environnement production
# Copier vers /etc/cardoria/cardoria.env sur OVH. Ne jamais committer de secrets.

NODE_ENV=production
APP_VERSION=6.0.0
PORT=10000
NODE_VERSION=22.22.0

# ── Sécurité ──
ADMIN_CODE=
LEGACY_ADMIN_CODE=false
ADMIN_EMAIL=Cardoria59330@gmail.com
ADMIN_INITIAL_PASSWORD=
SESSION_HOURS=12
# Sessions clients persistantes (admins restent sur SESSION_HOURS)
CLIENT_SESSION_DAYS=30
CSRF_ENABLED=false
CORS_ORIGINS=https://www.cardoriashop.fr,https://cardoriashop.fr
BODY_LIMIT=15mb
RATE_LIMIT_API=120
# Budget de signalisation WebRTC Live (par session et par operation)
RATE_LIMIT_LIVE_REALTIME=360
RATE_LIMIT_AUTH=10
RATE_LIMIT_PASSWORD_RESET=8
RATE_LIMIT_AI=8
BRUTE_FORCE_MAX=5
ALERT_EMAIL=true

# ── Base de données ──
DATABASE_URL=
MARKETPLACE_DATABASE_URL=
USE_POSTGRES=false
PG_SSL=true
PG_POOL_MAX=10

# ── Sauvegardes ──
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_KEEP=14

# ── Lancement V1.0 ──
JOURNAL_MAX_LINES=10000
HEALTH_ALERT_INTERVAL_MS=900000
ALERT_COOLDOWN_MS=3600000

# ── OpenAI ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CONFIDENCE_THRESHOLD=95
AI_ENTERPRISE_WORKER_MS=900000

# ── Ultimate Enterprise ──
ULTIMATE_WORKER_MS=1200000

# ── Big Data Engine ──
BIGDATA_WORKER_MS=1500000

# ── Email ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Adresse visible par le client. Pour la prod, utiliser une boite du domaine,
# par ex. commandes@cardoriashop.fr, uniquement apres SPF/DKIM/DMARC valides.
MAIL_FROM=
MAIL_FROM_NAME=Cardoria
MAIL_REPLY_TO=
# Selecteur DKIM fourni par l'hebergeur mail (ex. default, selector1, ...).
MAIL_DKIM_SELECTOR=
MAIL_TO=Cardoria59330@gmail.com

# ── SumUp (Boutique + Live Cardoria/Admin) ──
# Remplir uniquement dans /etc/cardoria/cardoria.env — jamais dans Git.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_WEBHOOK_SECRET=
SUMUP_API_BASE=https://api.sumup.com
BOUTIQUE_SUCCESS_URL=https://www.cardoriashop.fr/boutique.html?gamme=pokemon

# ── Cloudflare Realtime (Live WebRTC Cardoria/OVH) ──
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
CLOUDFLARE_REALTIME_API_URL=https://rtc.live.cloudflare.com/v1

# ── Revolut (retiré des parcours actifs) ──
REVOLUT_ENVIRONMENT=sandbox
REVOLUT_SECRET_KEY=
REVOLUT_WEBHOOK_SECRET=
REVOLUT_API_VERSION=2026-04-20
REVOLUT_API_BASE=

# ── PayPal Marketplace + Live vendeur ──
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_DISBURSEMENT_MODE=INSTANT

# ── Marketplace ──
MARKETPLACE_SUCCESS_URL=https://www.cardoriashop.fr/marketplace-paiement-succes.html
MARKETPLACE_CANCEL_URL=https://www.cardoriashop.fr/marketplace-paiement-echec.html
MARKETPLACE_VAT_RATE=20
MARKETPLACE_FRONTEND_URL=https://www.cardoriashop.fr

# Mode démo Marketplace temporaire
MARKETPLACE_DEMO_MODE=false

# ── Site & SEO ──
SITE_URL=https://www.cardoriashop.fr
FRONTEND_URL=https://www.cardoriashop.fr
PUBLIC_SITE_URL=https://www.cardoriashop.fr
RESET_TOKEN_HOURS=2
GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
GSC_VERIFIED=false

# ── Cache ──
CACHE_TTL_MS=60000

# ── Scanner IA ──
SCANNER_MAX_IMAGES=6

# ── Mondial Relay direct ──
# Recherche Point Relais WSI4 (Mon profil -> Mes paramètres de connexion)
MONDIAL_RELAY_ENSEIGNE=
MONDIAL_RELAY_PRIVATE_KEY=
# Création d'étiquette API V2 (Mondial Relay Connect -> API Configuration -> V2.0)
MONDIAL_RELAY_API_V2_LOGIN=
MONDIAL_RELAY_API_V2_PASSWORD=
MONDIAL_RELAY_API_V2_CUSTOMER_ID=
MONDIAL_RELAY_API_V2_ENV=sandbox
MONDIAL_RELAY_LABEL_FORMAT=10x15
# Laisser false jusqu'à validation d'une étiquette de test directe.
MONDIAL_RELAY_LIVE_LABELS_ENABLED=false

# Adresse expéditeur Cardoria pour les Lives administrés par Cardoria
CARDORIA_SENDER_NAME=Cardoria
CARDORIA_SENDER_ADDRESS_LINE1=
CARDORIA_SENDER_ADDRESS_LINE2=
CARDORIA_SENDER_POSTAL_CODE=
CARDORIA_SENDER_CITY=
CARDORIA_SENDER_COUNTRY=FR
CARDORIA_SENDER_PHONE=
CARDORIA_SENDER_EMAIL=Cardoria59330@gmail.com

# Sendcloud reste uniquement disponible pour les flux non Mondial Relay existants.
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
SENDCLOUD_WEBHOOK_SECRET=
SENDCLOUD_LIVE_LABELS_ENABLED=false
SENDCLOUD_LETTER_CARRIER_CODE=

# ── Colissimo / La Poste direct ──
# Clé Web Services disponible dans la Cbox Colissimo -> Profil.
COLISSIMO_API_KEY=
COLISSIMO_API_BASE=https://ws.colissimo.fr/sls-ws/SlsServiceWSRest/3.1
COLISSIMO_PRODUCT_CODE=DOM
COLISSIMO_LABEL_FORMAT=PDF_10x15_300dpi
# Laisser false jusqu'à validation d'une étiquette de test.
COLISSIMO_LIVE_LABELS_ENABLED=false

# ── Autres Shipping APIs (optionnel) ──
CHRONOPOST_API_KEY=
